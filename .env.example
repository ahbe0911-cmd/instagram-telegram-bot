# توکن را فقط به‌صورت Secret/Environment Variable وارد کنید.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_botfather_token

# تنظیمات اختیاری
MAX_CONCURRENT_DOWNLOADS=2
MAX_REQUESTS_PER_MINUTE=4
MAX_UPLOAD_MB=49
LOG_LEVEL=INFO

# برای دانلود استوری عمومی Instagram لازم است.
# این مقادیر را فقط در Secret/Environment سرور نگهداری کنید و داخل GitHub Commit نکنید.
INSTAGRAM_USERNAME=
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
