# توکن را فقط به‌صورت Secret/Environment Variable وارد کنید.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_botfather_token

# برای شخصی‌کردن ربات، Telegram User ID عددی مالک را وارد کنید.
# وقتی این مقدار تنظیم شود، کاربران دیگر هیچ پاسخی از ربات نمی‌گیرند.
ALLOWED_TELEGRAM_USER_ID=

# تنظیمات اختیاری
MAX_CONCURRENT_DOWNLOADS=2
MAX_REQUESTS_PER_MINUTE=4
MAX_UPLOAD_MB=49
LOG_LEVEL=INFO

# روش پیشنهادی و ساده برای دانلود Story عمومی؛ فقط یک API Key لازم است.
SOCLIP_API_KEY=

# روش قدیمی Session فقط برای سازگاری نگه داشته شده و لازم نیست پر شود.
INSTAGRAM_USERNAME=
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
